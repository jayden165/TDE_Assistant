BOT_TOKEN=
# The one server this bot runs in (commands sync there instantly).
GUILD_ID=

STAFF_ROLE_ID=
ADMIN_ROLE_ID=

# Logs
LOG_CHANNEL_ID=
MOD_LOG_CHANNEL_ID=          # falls back to LOG_CHANNEL_ID
ANTIRAID_LOG_CHANNEL_ID=     # falls back to LOG_CHANNEL_ID
HONEYPOT_LOG_CHANNEL_ID=
STAFF_ACTION_LOG_CHANNEL_ID= # /purge log

# Tickets
TICKET_CATEGORY_ID=
TICKET_PANEL_CHANNEL_ID=
TRANSCRIPT_CHANNEL_ID=

# Applications
APPLICATION_LOG_CHANNEL_ID=
APPLICATION_ACCEPTED_CHANNEL_ID=
APPLICATION_DENIED_CHANNEL_ID=

# Modmail (both optional - fall back to the ticket category / transcript channel)
MODMAIL_CATEGORY_ID=
MODMAIL_LOG_CHANNEL_ID=

# Moderation
MUTE_ROLE_ID=

# Optional: link shown on a button under /rules
RULES_URL=

# Optional: who receives /customcmd request feature requests by DM (defaults to the setup user)
DEV_USER_ID=

# Optional: normal members can run this many commands per window (staff/admins/owners are exempt; 0 = no limit)
MEMBER_COMMAND_LIMIT=5
MEMBER_COMMAND_WINDOW=30

# Minecraft server for /recording-post (whitelisting actors over RCON). Keep the real password only in .env.
RCON_HOST=
RCON_PORT=25575
RCON_PASSWORD=
# Commands sent over RCON; {username} is replaced. Adjust if your whitelist plugin differs.
RCON_ADD_COMMAND=wl {username}
RCON_REMOVE_COMMAND=whitelist remove {username}
# Role given to actors who sign up
RECORDING_ACTOR_ROLE_ID=1563819351034036224

# Global ban: a ban in any server the bot is in is mirrored to all its other servers (set false to turn off)
GLOBAL_BAN_ENABLED=true
# false = an unban only lifts the bans this feature made; true = it lifts every ban of that user in every server
GLOBAL_UNBAN_ALL=false

# YouTube upload notifier: new videos, Shorts and community posts are announced in the channel set with /upload channel set
YOUTUBE_CHANNEL_HANDLE=@thedailyemeraldmc
YOUTUBE_CHANNEL_NAME=The Daily Emerald
# Optional: the channel's UC... ID (otherwise it's looked up from the handle), and how often to check
YOUTUBE_CHANNEL_ID=
YOUTUBE_POLL_MINUTES=5

# YouTube channel to announce (defaults to The Daily Emerald) and how often to check, in minutes
YOUTUBE_CHANNEL_ID=UCTHIdKaVTME8g-6KHcCW-Jg
YOUTUBE_CHANNEL_HANDLE=thedailyemeraldmc
YOUTUBE_CHANNEL_NAME=The Daily Emerald
YOUTUBE_POLL_MINUTES=5
